{
  "name": "prava-ui",
  "version": "1.0.0-rc.1",
  "private": false,
  "type": "module",
  "description": "Accessible, responsive React components with compiled CSS.",
  "license": "MIT",
  "author": "Dinesh Shinde",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dineshdcshinde/prava-ui.git"
  },
  "homepage": "https://github.com/dineshdcshinde/prava-ui#readme",
  "bugs": {
    "url": "https://github.com/dineshdcshinde/prava-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "component-library",
    "ui",
    "design-system",
    "accessibility",
    "a11y",
    "rtl",
    "dark-mode",
    "typescript"
  ],
  "publishConfig": {
    "tag": "next"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/button.js"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/badge.js"
    },
    "./avatar": {
      "types": "./dist/components/avatar/index.d.ts",
      "import": "./dist/avatar.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner/index.d.ts",
      "import": "./dist/spinner.js"
    },
    "./input": {
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/input.js"
    },
    "./card": {
      "types": "./dist/components/card/index.d.ts",
      "import": "./dist/card.js"
    },
    "./separator": {
      "types": "./dist/components/separator/index.d.ts",
      "import": "./dist/separator.js"
    },
    "./skeleton": {
      "types": "./dist/components/skeleton/index.d.ts",
      "import": "./dist/skeleton.js"
    },
    "./progress": {
      "types": "./dist/components/progress/index.d.ts",
      "import": "./dist/progress.js"
    },
    "./textarea": {
      "types": "./dist/components/textarea/index.d.ts",
      "import": "./dist/textarea.js"
    },
    "./label": {
      "types": "./dist/components/label/index.d.ts",
      "import": "./dist/label.js"
    },
    "./form-field": {
      "types": "./dist/components/form-field/index.d.ts",
      "import": "./dist/form-field.js"
    },
    "./provider": {
      "types": "./dist/components/provider/index.d.ts",
      "import": "./dist/provider.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/index.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./switch": {
      "types": "./dist/components/switch/index.d.ts",
      "import": "./dist/switch.js"
    },
    "./radio-group": {
      "types": "./dist/components/radio-group/index.d.ts",
      "import": "./dist/radio-group.js"
    },
    "./select": {
      "types": "./dist/components/select/index.d.ts",
      "import": "./dist/select.js"
    },
    "./alert": {
      "types": "./dist/components/alert/index.d.ts",
      "import": "./dist/alert.js"
    },
    "./container": {
      "types": "./dist/components/container/index.d.ts",
      "import": "./dist/container.js"
    },
    "./stack": {
      "types": "./dist/components/stack/index.d.ts",
      "import": "./dist/stack.js"
    },
    "./grid": {
      "types": "./dist/components/grid/index.d.ts",
      "import": "./dist/grid.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog/index.d.ts",
      "import": "./dist/dialog.js"
    },
    "./drawer": {
      "types": "./dist/components/drawer/index.d.ts",
      "import": "./dist/drawer.js"
    },
    "./popover": {
      "types": "./dist/components/popover/index.d.ts",
      "import": "./dist/popover.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip/index.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./dropdown-menu": {
      "types": "./dist/components/dropdown-menu/index.d.ts",
      "import": "./dist/dropdown-menu.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs/index.d.ts",
      "import": "./dist/tabs.js"
    },
    "./accordion": {
      "types": "./dist/components/accordion/index.d.ts",
      "import": "./dist/accordion.js"
    },
    "./toast": {
      "types": "./dist/components/toast/index.d.ts",
      "import": "./dist/toast.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/tokens.css": "./dist/tokens.css",
    "./styles/components/*": "./dist/styles/components/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "scripts": {
    "start": "storybook dev -p 6006",
    "dev": "storybook dev -p 6006",
    "build": "vite build && npm run build:tokens",
    "build:tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:package": "node scripts/package-check.mjs",
    "prepublishOnly": "npm run build && npm run test:package",
    "release:check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run storybook:build && npm run test:package && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.0",
    "happy-dom": "^18.0.0",
    "prettier": "^3.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.91.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0"
  }
}
